{
  "rules": {
    ".read": false,
    ".write": false,

    "rifa": {

      "configuracao": {
        ".read": true,
        ".write": "auth != null && auth.token.admin === true"
      },

      "numeros": {

        ".read": true,

        "$numero": {
          ".read": true,

          ".write": "auth != null && auth.token.admin === true"
        }
      },

      "raspadinha": {

        "configuracao": {
          ".read": true,
          ".write": "auth != null && auth.token.admin === true"
        },

        "premios": {
          ".read": "auth != null && auth.token.admin === true",
          ".write": "auth != null && auth.token.admin === true"
        },

        "novasChances": {
          ".read": "auth != null && auth.token.admin === true",
          ".write": "auth != null && auth.token.admin === true"
        },

        "jogadas": {

          ".read": "auth != null && auth.token.admin === true",

          ".write": false,

          "$jogada": {

            ".read": "auth != null && (auth.token.admin === true || data.child('participanteId').val() === auth.uid)",

            ".write": false
          }
        }
      }
    }
  }
}
